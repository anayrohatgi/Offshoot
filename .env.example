# Copy to .env and fill in real values. Never commit .env.

# Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Todoist (Settings -> Integrations -> Developer -> API token)
TODOIST_API_TOKEN=your-todoist-token-here
# Todoist project to dispatch project-idea tasks into
TODOIST_PROJECT_ID=your-project-id-here

# Google Calendar (OAuth client, not a service-account key)
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google_calendar_client_secret.json
GOOGLE_CALENDAR_TOKEN_PATH=./credentials/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary
